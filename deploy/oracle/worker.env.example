# Copy to the repo root on the VM as .env (chmod 600). Values must match Vercel.
# Worker talks to Redis on the same VM, without leaving the machine.
REDIS_URL=redis://openreply:REDIS_PASSWORD@127.0.0.1:6379
# Neon pooled URL (same as Vercel's DATABASE_URL).
DATABASE_URL=
DB_POOL_MAX=5
NEXTAUTH_URL=https://your-app.vercel.app
ENCRYPTION_KEY=
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_SECRET=
